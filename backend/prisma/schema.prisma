generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  RECEPTIONIST
  BARBER
  CLIENT
}

enum PlatformRole {
  SUPER_ADMIN
}

enum BusinessStatus {
  PENDING
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum BillingInterval {
  MONTH
  YEAR
}

enum PaymentProvider {
  MERCADO_PAGO
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
  SUSPENDED
}

enum SubscriptionPaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
  REFUNDED
  CHARGED_BACK
  ERROR
}

enum SubscriptionPlan {
  ESSENTIAL
  PRO
}

enum BusinessCategory {
  BARBERSHOP
  HAIR_SALON
  NAIL_SALON
  BEAUTY_CENTER
  MASSAGE_CENTER
  OTHER
}

enum LeadContactPreference {
  WHATSAPP
  EMAIL
  EITHER
}

enum PlanRequestStatus {
  NEW
  CHECKOUT_PENDING
  PAID
  PAYMENT_REVERSED
  CONTACTED
  CONVERTED
  CLOSED
}

enum PlanDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PlanPaymentStatus {
  CREATED
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
  CHARGED_BACK
  ERROR
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  ONLINE
  PHONE
  IN_PERSON
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Business {
  id           Int     @id @default(autoincrement())
  name         String
  slug         String  @unique
  phone        String?
  email        String?
  address      String?
  logoUrl      String?
  instagramUrl String? @db.VarChar(500)
  twitterUrl   String? @db.VarChar(500)
  facebookUrl  String? @db.VarChar(500)
  whatsappUrl  String? @db.VarChar(500)
  timezone     String  @default("America/Santiago")
  currency     String  @default("CLP")

  appointmentInterval Int @default(15)
  minimumAdvanceTime  Int @default(60)
  maximumAdvanceDays  Int @default(60)

  cancellationMinimumMinutes Int     @default(120)
  rescheduleMinimumMinutes   Int     @default(120)
  allowClientCancellation    Boolean @default(true)
  allowClientRescheduling    Boolean @default(true)
  cancellationPolicy         String? @db.VarChar(1000)

  barberStartEarlyMinutes Int @default(15)
  noShowGraceMinutes      Int @default(15)

  status          BusinessStatus @default(ACTIVE)
  statusChangedAt DateTime       @default(now())
  statusReason    String?        @db.VarChar(1000)
  suspendedAt     DateTime?
  inactivatedAt   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users         User[]
  invitations   BusinessInvitation[]
  barbers       Barber[]
  categories    Category[]
  services      Service[]
  appointments  Appointment[]
  subscriptions Subscription[]

  @@index([status])
  @@map("businesses")
}

model CustomerIdentity {
  id String @id @default(uuid()) @db.Uuid

  email String  @unique
  phone String?

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@map("customer_identities")
}

model User {
  id         Int      @id @default(autoincrement())
  businessId Int
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  customerIdentityId String?           @db.Uuid
  customerIdentity   CustomerIdentity? @relation(fields: [customerIdentityId], references: [id], onDelete: SetNull)

  firstName String
  lastName  String
  phone     String
  email     String?

  passwordHash String?
  role         UserRole @default(CLIENT)

  birthDate     DateTime? @db.Date
  isRegistered  Boolean   @default(false)
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  phoneVerified Boolean   @default(false)
  lastLoginAt   DateTime?

  emailVerificationTokenHash String?   @unique @db.VarChar(64)
  emailVerificationExpiresAt DateTime?
  emailVerificationSentAt    DateTime?

  passwordResetTokenHash String?   @unique @db.VarChar(64)
  passwordResetExpiresAt DateTime?
  passwordResetSentAt    DateTime?

  authVersion Int @default(0)

  barber Barber?

  appointments              Appointment[]        @relation("CustomerAppointments")
  appointmentHistoryEntries AppointmentHistory[] @relation("AppointmentHistoryActor")
  authSessions              AuthSession[]
  businessInvitation        BusinessInvitation?
  ownedSubscriptions        Subscription[]       @relation("SubscriptionOwner")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([businessId, phone])
  @@unique([businessId, email])
  @@index([businessId, role])
  @@index([customerIdentityId])
  @@index([firstName, lastName])
  @@index([isActive])
  @@map("users")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           Int
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique @db.VarChar(64)
  authVersion      Int
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, revokedAt, expiresAt])
  @@map("auth_sessions")
}

model PlatformUser {
  id Int @id @default(autoincrement())

  firstName String
  lastName  String
  email     String @unique

  passwordHash String
  role         PlatformRole @default(SUPER_ADMIN)

  isActive    Boolean   @default(true)
  authVersion Int       @default(0)
  lastLoginAt DateTime?

  authSessions            PlatformAuthSession[]
  sentBusinessInvitations BusinessInvitation[]  @relation("PlatformInvitationSender")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([isActive])
  @@map("platform_users")
}

model PlatformAuthSession {
  id String @id @default(uuid()) @db.Uuid

  platformUserId Int
  platformUser   PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  refreshTokenHash String    @unique @db.VarChar(64)
  authVersion      Int
  expiresAt        DateTime
  revokedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([platformUserId, revokedAt, expiresAt])
  @@map("platform_auth_sessions")
}

model BusinessInvitation {
  id Int @id @default(autoincrement())

  businessId Int
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  invitedByPlatformUserId Int?
  invitedByPlatformUser   PlatformUser? @relation("PlatformInvitationSender", fields: [invitedByPlatformUserId], references: [id], onDelete: SetNull)

  email      String
  tokenHash  String    @unique @db.VarChar(64)
  expiresAt  DateTime
  sentAt     DateTime?
  acceptedAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, acceptedAt, revokedAt])
  @@index([email, expiresAt])
  @@map("business_invitations")
}

model PlanRequest {
  id Int @id @default(autoincrement())

  plan           SubscriptionPlan
  basePrice      Int
  discountAmount Int              @default(0)
  monthlyPrice   Int
  teamSize       Int

  discountId Int?
  discount   PlanDiscount? @relation(fields: [discountId], references: [id], onDelete: SetNull)
  promoCode  String?

  businessName     String
  businessCategory BusinessCategory
  desiredSlug      String?

  contactName       String
  email             String
  phone             String
  contactPreference LeadContactPreference
  notes             String?               @db.VarChar(1000)

  status      PlanRequestStatus @default(NEW)
  contactedAt DateTime?
  closedAt    DateTime?

  checkoutTokenHash String?        @unique @db.VarChar(64)
  checkouts         PlanCheckout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email, createdAt])
  @@map("plan_requests")
}

model Plan {
  id Int @id @default(autoincrement())

  code              String          @unique @db.VarChar(50)
  name              String
  description       String          @db.VarChar(1000)
  priceAmount       Int
  currency          String          @default("CLP") @db.VarChar(3)
  interval          BillingInterval @default(MONTH)
  intervalCount     Int             @default(1)
  minimumTeamSize   Int
  maximumTeamSize   Int
  features          Json
  limits            Json?
  mercadoPagoPlanId String?         @unique
  active            Boolean         @default(true)

  discounts     PlanDiscount[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plan_configs")
}

model PlanDiscount {
  id Int @id @default(autoincrement())

  planId Int
  plan   Plan             @relation(fields: [planId], references: [id], onDelete: Restrict)
  name   String
  type   PlanDiscountType
  value  Int

  code      String?   @unique
  autoApply Boolean   @default(false)
  isActive  Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?

  planRequests  PlanRequest[]
  checkouts     PlanCheckout[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId, autoApply, isActive, startsAt, endsAt])
  @@map("plan_discounts")
}

model Subscription {
  id String @id @default(uuid()) @db.Uuid

  businessId Int
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  planId Int
  plan   Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  discountId   Int?
  discount     PlanDiscount? @relation(fields: [discountId], references: [id], onDelete: SetNull)
  discountName String?
  promoCode    String?

  ownerUserId Int?
  ownerUser   User? @relation("SubscriptionOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  provider               PaymentProvider
  providerSubscriptionId String?
  providerPayerId        String?
  providerStatus         String?
  providerStatusDetail   String?
  providerUpdatedAt      DateTime?

  status    SubscriptionStatus @default(PENDING)
  activeKey String?            @unique @db.VarChar(64)

  baseAmount     Int
  discountAmount Int             @default(0)
  amount         Int
  currency       String          @db.VarChar(3)
  interval       BillingInterval
  intervalCount  Int

  authorizationUrl String? @db.VarChar(1000)
  paymentMethodId  String?

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  nextPaymentAt      DateTime?
  pastDueAt          DateTime?
  graceEndsAt        DateTime?

  cancelAtPeriodEnd       Boolean   @default(false)
  cancellationRequestedAt DateTime?
  canceledAt              DateTime?

  payments SubscriptionPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerSubscriptionId])
  @@index([businessId, status])
  @@index([planId, status])
  @@index([nextPaymentAt])
  @@index([graceEndsAt])
  @@map("subscriptions")
}

model SubscriptionPayment {
  id String @id @default(uuid()) @db.Uuid

  subscriptionId String       @db.Uuid
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  provider          PaymentProvider
  providerPaymentId String
  providerInvoiceId String?

  amount   Int
  currency String                    @db.VarChar(3)
  status   SubscriptionPaymentStatus

  rawStatus       String?
  rawStatusDetail String?
  periodStart     DateTime?
  periodEnd       DateTime?
  paidAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerPaymentId])
  @@unique([provider, providerInvoiceId])
  @@index([subscriptionId, createdAt])
  @@index([status, createdAt])
  @@map("subscription_payments")
}

model PlanCheckout {
  id String @id @default(uuid()) @db.Uuid

  planRequestId Int
  planRequest   PlanRequest @relation(fields: [planRequestId], references: [id], onDelete: Restrict)
  activeKey     String?     @unique @db.VarChar(64)

  plan           SubscriptionPlan
  basePrice      Int
  discountAmount Int
  finalAmount    Int
  currency       String           @default("CLP")

  discountId   Int?
  discount     PlanDiscount? @relation(fields: [discountId], references: [id], onDelete: SetNull)
  discountName String?
  promoCode    String?

  status PlanPaymentStatus @default(CREATED)

  mercadoPagoPreferenceId String?  @unique
  mercadoPagoPaymentId    String?  @unique
  mercadoPagoStatus       String?
  mercadoPagoStatusDetail String?
  initPoint               String?  @db.VarChar(1000)
  liveMode                Boolean?

  expiresAt DateTime?
  paidAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planRequestId, createdAt])
  @@index([status, createdAt])
  @@map("plan_checkouts")
}

model Barber {
  id         Int      @id @default(autoincrement())
  businessId Int
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  userId Int?  @unique
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  displayName String
  specialty   String?
  biography   String?
  photoUrl    String?

  calendarColor        String?
  commissionPercentage Decimal? @db.Decimal(5, 2)

  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  services           BarberService[]
  appointments       Appointment[]
  schedules          Schedule[]
  scheduleExceptions ScheduleException[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([businessId, isActive])
  @@index([displayOrder])
  @@map("barbers")
}

model Category {
  id         Int      @id @default(autoincrement())
  businessId Int
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name         String
  description  String?
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  services Service[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([businessId, name])
  @@index([businessId, isActive, displayOrder])
  @@map("categories")
}

model Service {
  id         Int      @id @default(autoincrement())
  businessId Int
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  name        String
  description String?
  imageUrl    String?

  durationMinutes Int
  bufferBefore    Int @default(0)
  bufferAfter     Int @default(0)

  price Decimal @db.Decimal(12, 2)

  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  barbers             BarberService[]
  appointmentServices AppointmentService[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([businessId, name])
  @@index([businessId, categoryId, isActive])
  @@index([displayOrder])
  @@map("services")
}

model BarberService {
  id Int @id @default(autoincrement())

  barberId Int
  barber   Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  serviceId Int
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  customDurationMinutes Int?
  customPrice           Decimal? @db.Decimal(12, 2)
  isActive              Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([barberId, serviceId])
  @@index([serviceId, isActive])
  @@map("barber_services")
}

model Appointment {
  id         Int      @id @default(autoincrement())
  businessId Int
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  customerId Int
  customer   User @relation("CustomerAppointments", fields: [customerId], references: [id], onDelete: Restrict)

  barberId Int
  barber   Barber @relation(fields: [barberId], references: [id], onDelete: Restrict)

  startAt DateTime
  endAt   DateTime

  status AppointmentStatus @default(PENDING)
  source AppointmentSource @default(ONLINE)

  totalDurationMinutes Int
  subtotal             Decimal @db.Decimal(12, 2)
  discountAmount       Decimal @default(0) @db.Decimal(12, 2)
  totalPrice           Decimal @db.Decimal(12, 2)

  customerNotes String?
  internalNotes String?

  confirmationCode String @unique

  managementTokenHash String? @unique @db.VarChar(64)

  confirmedAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  noShowAt    DateTime?

  cancellationReason String?
  cancelledById      Int?

  services AppointmentService[]
  history  AppointmentHistory[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([businessId, startAt])
  @@index([barberId, startAt, endAt])
  @@index([customerId, startAt])
  @@index([status, startAt])
  @@map("appointments")
}

model AppointmentService {
  id Int @id @default(autoincrement())

  appointmentId Int
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  serviceId Int
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  serviceName String

  durationMinutes Int
  bufferBefore    Int @default(0)
  bufferAfter     Int @default(0)

  unitPrice  Decimal @db.Decimal(12, 2)
  finalPrice Decimal @db.Decimal(12, 2)

  displayOrder Int @default(0)

  createdAt DateTime @default(now())

  @@unique([appointmentId, serviceId])
  @@index([serviceId])
  @@map("appointment_services")
}

model AppointmentHistory {
  id Int @id @default(autoincrement())

  appointmentId Int
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  actorId Int?
  actor   User? @relation("AppointmentHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  previousStatus AppointmentStatus?
  newStatus      AppointmentStatus
  comment        String?

  createdAt DateTime @default(now())

  @@index([appointmentId, createdAt])
  @@index([actorId])
  @@map("appointment_history")
}

model Schedule {
  id Int @id @default(autoincrement())

  barberId Int
  barber   Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  dayOfWeek   DayOfWeek
  startMinute Int
  endMinute   Int

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([barberId, dayOfWeek, startMinute, endMinute])
  @@index([barberId, dayOfWeek, isActive])
  @@map("schedules")
}

model ScheduleException {
  id Int @id @default(autoincrement())

  barberId Int
  barber   Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  date DateTime @db.Date

  isDayOff Boolean @default(false)

  startMinute Int?
  endMinute   Int?

  reason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([barberId, date])
  @@map("schedule_exceptions")
}
