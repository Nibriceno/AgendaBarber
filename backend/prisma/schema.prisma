generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  RECEPTIONIST
  BARBER
  CLIENT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Business {
  id           Int     @id @default(autoincrement())
  name         String
  slug         String  @unique
  phone        String?
  email        String?
  address      String?
  logoUrl      String?
  instagramUrl String? @db.VarChar(500)
  twitterUrl   String? @db.VarChar(500)
  facebookUrl  String? @db.VarChar(500)
  whatsappUrl  String? @db.VarChar(500)
  timezone     String  @default("America/Santiago")
  currency     String  @default("CLP")

  appointmentInterval Int @default(15)
  minimumAdvanceTime  Int @default(60)
  maximumAdvanceDays  Int @default(60)

  cancellationMinimumMinutes Int     @default(120)
  rescheduleMinimumMinutes   Int     @default(120)
  allowClientCancellation    Boolean @default(true)
  allowClientRescheduling    Boolean @default(true)
  cancellationPolicy         String? @db.VarChar(1000)

  barberStartEarlyMinutes Int @default(15)
  noShowGraceMinutes      Int @default(15)

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users        User[]
  barbers      Barber[]
  categories   Category[]
  services     Service[]
  appointments Appointment[]

  @@index([isActive])
  @@map("businesses")
}

model User {
  id         Int      @id @default(autoincrement())
  businessId Int
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String
  phone     String
  email     String?

  passwordHash String?
  role         UserRole @default(CLIENT)

  birthDate     DateTime? @db.Date
  isRegistered  Boolean   @default(false)
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  phoneVerified Boolean   @default(false)
  lastLoginAt   DateTime?

  emailVerificationTokenHash String?   @unique @db.VarChar(64)
  emailVerificationExpiresAt DateTime?
  emailVerificationSentAt    DateTime?

  passwordResetTokenHash String?   @unique @db.VarChar(64)
  passwordResetExpiresAt DateTime?
  passwordResetSentAt    DateTime?

  authVersion Int @default(0)

  barber Barber?

  appointments              Appointment[]        @relation("CustomerAppointments")
  appointmentHistoryEntries AppointmentHistory[] @relation("AppointmentHistoryActor")
  authSessions              AuthSession[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([businessId, phone])
  @@unique([businessId, email])
  @@index([businessId, role])
  @@index([firstName, lastName])
  @@index([isActive])
  @@map("users")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           Int
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique @db.VarChar(64)
  authVersion      Int
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, revokedAt, expiresAt])
  @@map("auth_sessions")
}

model Barber {
  id         Int      @id @default(autoincrement())
  businessId Int
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  userId Int?  @unique
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  displayName String
  specialty   String?
  biography   String?
  photoUrl    String?

  calendarColor        String?
  commissionPercentage Decimal? @db.Decimal(5, 2)

  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  services           BarberService[]
  appointments       Appointment[]
  schedules          Schedule[]
  scheduleExceptions ScheduleException[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([businessId, isActive])
  @@index([displayOrder])
  @@map("barbers")
}

model Category {
  id         Int      @id @default(autoincrement())
  businessId Int
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name         String
  description  String?
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  services Service[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([businessId, name])
  @@index([businessId, isActive, displayOrder])
  @@map("categories")
}

model Service {
  id         Int      @id @default(autoincrement())
  businessId Int
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  name        String
  description String?
  imageUrl    String?

  durationMinutes Int
  bufferBefore    Int @default(0)
  bufferAfter     Int @default(0)

  price Decimal @db.Decimal(12, 2)

  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  barbers             BarberService[]
  appointmentServices AppointmentService[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([businessId, name])
  @@index([businessId, categoryId, isActive])
  @@index([displayOrder])
  @@map("services")
}

model BarberService {
  id Int @id @default(autoincrement())

  barberId Int
  barber   Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  serviceId Int
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  customDurationMinutes Int?
  customPrice           Decimal? @db.Decimal(12, 2)
  isActive              Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([barberId, serviceId])
  @@index([serviceId, isActive])
  @@map("barber_services")
}

model Appointment {
  id         Int      @id @default(autoincrement())
  businessId Int
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  customerId Int
  customer   User @relation("CustomerAppointments", fields: [customerId], references: [id], onDelete: Restrict)

  barberId Int
  barber   Barber @relation(fields: [barberId], references: [id], onDelete: Restrict)

  startAt DateTime
  endAt   DateTime

  status AppointmentStatus @default(PENDING)

  totalDurationMinutes Int
  subtotal             Decimal @db.Decimal(12, 2)
  discountAmount       Decimal @default(0) @db.Decimal(12, 2)
  totalPrice           Decimal @db.Decimal(12, 2)

  customerNotes String?
  internalNotes String?

  confirmationCode String @unique

  managementTokenHash String? @unique @db.VarChar(64)

  confirmedAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  noShowAt    DateTime?

  cancellationReason String?
  cancelledById      Int?

  services AppointmentService[]
  history  AppointmentHistory[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([businessId, startAt])
  @@index([barberId, startAt, endAt])
  @@index([customerId, startAt])
  @@index([status, startAt])
  @@map("appointments")
}

model AppointmentService {
  id Int @id @default(autoincrement())

  appointmentId Int
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  serviceId Int
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  serviceName String

  durationMinutes Int
  bufferBefore    Int @default(0)
  bufferAfter     Int @default(0)

  unitPrice  Decimal @db.Decimal(12, 2)
  finalPrice Decimal @db.Decimal(12, 2)

  displayOrder Int @default(0)

  createdAt DateTime @default(now())

  @@unique([appointmentId, serviceId])
  @@index([serviceId])
  @@map("appointment_services")
}

model AppointmentHistory {
  id Int @id @default(autoincrement())

  appointmentId Int
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  actorId Int?
  actor   User? @relation("AppointmentHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  previousStatus AppointmentStatus?
  newStatus      AppointmentStatus
  comment        String?

  createdAt DateTime @default(now())

  @@index([appointmentId, createdAt])
  @@index([actorId])
  @@map("appointment_history")
}

model Schedule {
  id Int @id @default(autoincrement())

  barberId Int
  barber   Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  dayOfWeek   DayOfWeek
  startMinute Int
  endMinute   Int

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([barberId, dayOfWeek, startMinute, endMinute])
  @@index([barberId, dayOfWeek, isActive])
  @@map("schedules")
}

model ScheduleException {
  id Int @id @default(autoincrement())

  barberId Int
  barber   Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  date DateTime @db.Date

  isDayOff Boolean @default(false)

  startMinute Int?
  endMinute   Int?

  reason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([barberId, date])
  @@map("schedule_exceptions")
}
