NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/barber_booking?schema=public

JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=14

# Recomendado en producción: usa un secreto diferente para la plataforma.
# Si se omite durante desarrollo, se reutiliza JWT_SECRET.
PLATFORM_JWT_SECRET=CHANGE_ME_WITH_ANOTHER_32_CHARACTER_SECRET
PLATFORM_JWT_EXPIRES_IN=15m
PLATFORM_REFRESH_TOKEN_EXPIRES_DAYS=14

FRONTEND_URL=http://localhost:3001
PUBLIC_APP_URL=http://localhost:3001
PUBLIC_API_URL=http://localhost:3000

# Mercado Pago Checkout Pro. Usa URLs HTTPS públicas (por ejemplo, un túnel)
# y credenciales de prueba antes de habilitar cobros reales.
MERCADO_PAGO_ENABLED=false
MERCADO_PAGO_USE_SANDBOX=true
MERCADO_PAGO_ALLOW_UNSIGNED_SUBSCRIPTION_WEBHOOKS=false
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_TEST_PAYER_EMAIL=
MERCADO_PAGO_CHECKOUT_EXPIRATION_HOURS=24
MERCADO_PAGO_WEBHOOK_TOLERANCE_SECONDS=300
SUBSCRIPTION_GRACE_PERIOD_DAYS=5

# Desarrollo local con Mailpit (docker compose up -d mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=AgendaYa <no-reply@agendaya.local>

# En producción configura las credenciales del proveedor SMTP.
# SMTP_USER=
# SMTP_PASS=
